@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SensorsSnapshotProtocol {

    // import previously defined schemas
    import idl "SensorEvent.avdl";

    // snapshot schema
    record SensorsSnapshotAvro {
        string hubId;                      // hub identifier
        timestamp_ms timestamp;            // snapshot timestamp
        map<SensorStateAvro> sensorsState; // sensor states map, key = sensor id
    }

    // sensor state schema
    record SensorStateAvro {
        timestamp_ms timestamp;  // timestamp when sensor data was sent
        union {                  // sensor-specific payload
            ClimateSensorAvro,
            LightSensorAvro,
            MotionSensorAvro,
            SwitchSensorAvro,
            TemperatureSensorAvro
        } data;
    }
}
