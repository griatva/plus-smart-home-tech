@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SensorEventProtocol {

    record ClimateSensorAvro {
        /** temperature in degrees Celsius */
        int temperature_c;

        /** humidity level */
        int humidity;

        /** carbon dioxide (CO2) level */
        int co2_level;
    }

    record LightSensorAvro {

        /** signal link quality */
        int link_quality;

        /** illumination level */
        int luminosity;
    }

    record MotionSensorAvro {
        /** signal link quality */
        int link_quality;

        /** indicates whether motion is detected */
        boolean motion;

        /** voltage level */
        int voltage;
    }

    record SwitchSensorAvro {
        boolean state;
    }

    record TemperatureSensorAvro {
        string id;
        string hubId;
        timestamp_ms timestamp;
        int temperature_c;
        int temperature_f;
    }

    record SensorEventAvro {
        string id;
        string hubId;
        timestamp_ms timestamp;
        union {
            ClimateSensorAvro,
            LightSensorAvro,
            MotionSensorAvro,
            SwitchSensorAvro,
            TemperatureSensorAvro
        } payload;
    }
}